# Repository Graphslop should inspect and prepare a build pack for.
GRAPHSLOP_REPOSITORY=/absolute/path/to/your/project

# Durable private state. Keep this outside source control.
GRAPHSLOP_PROJECT_STATE=/absolute/path/to/private/graphslop-state

# Any local OpenAI-compatible model server.
GRAPHSLOP_QWEN_URL=http://127.0.0.1:8001/v1

# Optional when the server exposes exactly one model.
# GRAPHSLOP_QWEN_MODEL=your-local-model-name

PORT=4173

# Optional exact hostname when the local server is exposed through a tunnel.
# GRAPHSLOP_PUBLIC_HOST=factory.example.com
# Hosted Cloudflare queue consumer
CLOUDFLARE_ACCOUNT_ID=
GRAPHSLOP_QUEUE_ID=
GRAPHSLOP_QUEUE_TOKEN=
GRAPHSLOP_APP_ORIGIN=https://graphslop.com
GRAPHSLOP_MODEL_RUNNER_TOKEN=

# Local OpenAI-compatible Qwen server
GRAPHSLOP_QWEN_URL=http://127.0.0.1:8001/v1
GRAPHSLOP_QWEN_MODEL=
