{
  "name": "@graphslop/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0 <25.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "if find apps packages -type f \\( -name '*.ts' -o -name '*.tsx' \\) -not -path '*/node_modules/*' -not -path '*/dist/*' -print -quit | grep -q .; then tsc --project tsconfig.json; else echo 'No TypeScript workspace sources to check.'; fi"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
