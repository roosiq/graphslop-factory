{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graphslop-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../control-plane/dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
