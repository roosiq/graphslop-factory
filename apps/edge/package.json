{
  "name": "@graphslop/edge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --workspace @graphslop/control-plane run build && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --keep-vars",
    "dev": "wrangler dev",
    "types": "wrangler types worker-configuration.d.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@graphslop/build-pack": "file:../../packages/build-pack",
    "@graphslop/codex-adapter": "file:../../packages/codex-adapter",
    "@graphslop/contracts": "file:../../packages/contracts",
    "@graphslop/control-state": "file:../../packages/control-state",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "wrangler": "^4.115.0"
  }
}
