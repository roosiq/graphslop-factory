{
  "name": "@graphslop/graph-kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm --workspace @graphslop/contracts run build && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "typecheck:consumer": "tsc --noEmit --target ES2024 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck ../../tests/kernel/metamodel.typecheck.ts",
    "test": "node --test ../../tests/kernel/metamodel-*.test.mjs ../../tests/kernel/scheduler-*.test.mjs ../../tests/kernel/completeness-*.test.mjs ../../tests/kernel/flywheel-*.test.mjs",
    "verify": "npm run build && npm run typecheck && npm run typecheck:consumer && npm run test"
  },
  "dependencies": {
    "@graphslop/contracts": "file:../contracts"
  }
}
